
DEVICE_ID=

FORCE_SETUP_MODE=false

DEVICE_USER=
DEVICE_PASSWORD=

APP_ENV=development
# APP_ENV=production

DEVICE_IP_DEV=

PROXY_TOKEN=

LAN_ACCESS=false
# Read often in RAM; commit ordinary telemetry in five-minute batches.
TELEMETRY_POLL_SECONDS=15
TELEMETRY_SAMPLE_SECONDS=300
TELEMETRY_FLUSH_SECONDS=300

# HA discovery: customer LAN only; default nginx HTTP port. No tokens here.
SEMA_HA_DISCOVERY_INTERFACES=wlan0
SEMA_HA_DISCOVERY_PORT=80
SEMA_HA_DISCOVERY_SCHEME=http
