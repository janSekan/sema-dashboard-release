#!/usr/bin/env bash
set -e

ENV_FILE="/home/jan/sema/.env"

DEVICE_ID=""
HOSTNAME_VALUE=""
PROXY_TOKEN=""
LAN_ACCESS="false"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --device-id)
      DEVICE_ID="$2"
      shift 2
      ;;
    --hostname)
      HOSTNAME_VALUE="$2"
      shift 2
      ;;
    --proxy-token)
      PROXY_TOKEN="$2"
      shift 2
      ;;
    --lan-access)
      LAN_ACCESS="$2"
      shift 2
      ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
done

if [[ -z "$DEVICE_ID" || -z "$HOSTNAME_VALUE" || -z "$PROXY_TOKEN" ]]; then
  echo "Missing required arguments."
  echo ""
  echo "Usage:"
  echo "sudo sema-provision --device-id SEMA-001 --hostname sema-001 --proxy-token TOKEN"
  exit 1
fi

if [[ ! -f "$ENV_FILE" ]]; then
  echo ".env file not found: $ENV_FILE"
  exit 1
fi

set_env() {
  KEY="$1"
  VALUE="$2"

  if grep -q "^${KEY}=" "$ENV_FILE"; then
    sed -i "s|^${KEY}=.*|${KEY}=${VALUE}|" "$ENV_FILE"
  else
    echo "${KEY}=${VALUE}" >> "$ENV_FILE"
  fi
}

echo "Provisioning SEMA device..."
echo ""

set_env "DEVICE_ID" "$DEVICE_ID"
echo "✔ DEVICE_ID=$DEVICE_ID"

set_env "HOSTNAME" "$HOSTNAME_VALUE"
echo "✔ HOSTNAME=$HOSTNAME_VALUE"

set_env "PROXY_TOKEN" "$PROXY_TOKEN"
echo "✔ PROXY_TOKEN updated"

set_env "LAN_ACCESS" "$LAN_ACCESS"
echo "✔ LAN_ACCESS=$LAN_ACCESS"

hostnamectl set-hostname "$HOSTNAME_VALUE"
echo "✔ System hostname updated"

systemctl restart sema.service
echo "✔ sema.service restarted"

systemctl reload nginx || systemctl restart nginx
echo "✔ nginx reloaded"

echo ""
echo "Done."
echo "Recommended: reboot device"
echo "sudo reboot"